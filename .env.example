# Toutes facultatives. Aucune valeur réelle dans ce fichier. Détail : docs/CONFIGURATION.md
# Dossier de données (fiches, ledger, rapports). Défaut : ~/.promo-projets
PROMO_DATA_DIR=
# User-Agent déclaré aux requêtes en lecture. Défaut : promo-projets/0.1 (lecture seule, aucune publication)
PROMO_USER_AGENT=
# Envoi Telegram (commande send), à exporter dans le shell, jamais à committer
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
